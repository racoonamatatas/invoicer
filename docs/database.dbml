Table users
{
  id integer [pk, increment]
  name varchar [not null]
  email varchar [not null, unique]
  email_verified_at timestamp [not null, note: 'a user only exists once the set-password link was used']
  password varchar [not null]
  remember_token varchar
  created_at timestamp
  updated_at timestamp
}

Table pending_registrations
{
  id integer [pk, increment]
  email varchar [not null, unique]
  token char(64) [not null, unique, note: 'sha256 of the token in the set-password link']
  expires_at timestamp [not null, note: 'pruned daily once passed']
  created_at timestamp
  updated_at timestamp
}

Table businesses
{
  id integer [pk, increment]
  user_id integer [not null]
  registered_name varchar [not null]
  kvk_number char(8) [not null, note: '8 digits']
  vat_number varchar(14) [not null, note: 'BTW-id, e.g. NL123456789B01']
  street varchar [not null, note: 'Same address shape as clients, so AddressRules, the form fields and the snapshot copy are shared; here always a Dutch address']
  house_number varchar(10) [not null, note: 'digits only, 1 to 99999']
  house_number_addition varchar(10) [note: 'BAG letter and addition, e.g. "a", "bis"']
  postal_code varchar(12) [not null, note: '"1234 AB"']
  city varchar [not null]
  region varchar [note: 'always null: a Dutch address has no region; the column exists for the shared shape']
  country_code char(2) [not null, note: 'ISO 3166-1 alpha-2, must be NL: a business is a KvK registration; its clients may be anywhere']
  payment_term_days integer [not null, note: 'default, e.g. 30']
  created_at timestamp
  updated_at timestamp

  indexes {
    (user_id, kvk_number) [unique, note: 'one registration once per user; another user may still claim the same number. Also serves lookups by user_id']
  }

  Note: 'invoice_number_pattern and invoice_number_reset come back with the Send epic, once the numbering design (INV-0049) is settled'
}

Table bank_accounts
{
  id integer [pk, increment]
  business_id integer [not null]
  iban varchar(34) [not null]
  label varchar [not null, note: 'Own name for it, e.g. "Main"']
  created_at timestamp
  updated_at timestamp

  indexes {
    (business_id, iban) [unique]
    (business_id, label) [unique]
  }
}

Table clients
{
  id integer [pk, increment]
  business_id integer [not null]
  name varchar [not null]
  email varchar [not null, note: 'every invoice is mailed to its client']
  vat_number varchar(14) [note: 'EU VAT id, e.g. DE123456789; only for an EU country (INV-0058), required on a reverse-charge invoice']
  street varchar [not null]
  house_number varchar(10) [not null]
  house_number_addition varchar(10)
  postal_code varchar(12)
  city varchar [not null]
  region varchar
  country_code char(2) [not null, note: 'ISO 3166-1 alpha-2; the rules tighten for NL']
  created_at timestamp
  updated_at timestamp

  indexes {
    business_id [note: 'no unique index leads with it, and SQLite does not index a foreign key by itself']
  }
}

Table invoices
{
  id integer [pk, increment]
  business_id integer [not null]
  client_id integer [not null]
  bank_account_id integer [not null]
  status integer [not null, note: 'InvoiceStatus; only draft for now, sent and paid come with sending. No default: the creator sets it']
  vat_treatment integer [not null, note: 'VatTreatment: domestic / reverse charge / outside scope. No default: the creator sets it']
  number varchar [note: 'null while draft']
  payment_term_days integer [note: 'override; null = use business default']
  created_at timestamp
  updated_at timestamp

  indexes {
    (business_id, number) [unique, note: 'NULLs are distinct, so any number of drafts can share a business. Also serves lookups by business_id']
  }
}

Table invoice_lines
{
  id integer [pk, increment]
  invoice_id integer [not null]
  position integer [not null, note: 'place on the invoice, from 1']
  description varchar [not null]
  quantity_hundredths integer [not null, note: 'unsigned; 1,5 hours is 150']
  unit_price_cents integer [not null, note: 'unsigned; excl. BTW']
  vat_option integer [note: 'VatOption: high / low / zero / exempt; null unless the treatment charges VAT']
  created_at timestamp
  updated_at timestamp

  indexes {
    (invoice_id, position) [unique, note: 'also serves lookups by invoice_id']
  }

  Note: 'vat_rate_percent comes back with the Send epic: the rate is copied onto the line on send, and nothing writes it before then'
}

Table invoice_snapshots
{
  id integer [pk, increment]
  invoice_id integer [not null, unique]
  issued_on date [not null, note: 'invoice date, set on send']
  due_on date [not null, note: 'issued_on + effective term, set on send']
  business_registered_name varchar [not null]
  business_kvk_number char(8) [not null]
  business_vat_number varchar(14) [not null]
  business_street varchar [not null]
  business_house_number varchar(10) [not null]
  business_house_number_addition varchar(10)
  business_postal_code varchar(12)
  business_city varchar [not null]
  business_region varchar
  business_country_code char(2) [not null]
  iban varchar(34) [not null]
  client_name varchar [not null]
  client_street varchar [not null]
  client_house_number varchar(10) [not null]
  client_house_number_addition varchar(10)
  client_postal_code varchar(12)
  client_city varchar [not null]
  client_region varchar
  client_country_code char(2) [not null]
  subtotal_cents integer [not null, note: 'excl. BTW']
  vat_cents integer [not null]
  total_cents integer [not null, note: 'incl. BTW']
  created_at timestamp
}

Ref: businesses.user_id > users.id [delete: restrict]
Ref: bank_accounts.business_id > businesses.id [delete: restrict]
Ref: clients.business_id > businesses.id [delete: restrict]
Ref: invoices.business_id > businesses.id [delete: restrict]
Ref: invoices.client_id > clients.id [delete: restrict]
Ref: invoices.bank_account_id > bank_accounts.id [delete: restrict]
Ref: invoice_lines.invoice_id > invoices.id [delete: cascade]
Ref: invoice_snapshots.invoice_id - invoices.id [delete: restrict]
