includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - app/
        - tests/
    # Read the casts from the body of casts(): its `@return array<string, string>` docblock says nothing per key.
    parseModelCastsMethod: true
    excludePaths:
        # Arch tests are declarative chains on arch(), which reach expect() through Pest's __call, so PHPStan can't see
        # them. They hold no logic to type-check.
        - tests/Arch/
        # Code that breaks the custom rules on purpose, for their RuleTestCase tests.
        - tests/PHPStan/RateLimiter/Fixtures/
        - tests/PHPStan/FormRequest/Fixtures/

services:
    -
        class: Tests\PHPStan\PestClosureThisExtension
        tags:
            - phpstan.functionParameterClosureThisExtension
    -
        class: Tests\PHPStan\RateLimiter\RequestCastCollector
        tags:
            - phpstan.collector
    -
        class: Tests\PHPStan\RateLimiter\LimiterHelperCallCollector
        tags:
            - phpstan.collector
    -
        class: Tests\PHPStan\RateLimiter\LimiterMethodCollector
        tags:
            - phpstan.collector
    -
        class: Tests\PHPStan\FormRequest\RulesKeysCollector
        tags:
            - phpstan.collector
    -
        class: Tests\PHPStan\FormRequest\ValidatedKeyReadCollector
        tags:
            - phpstan.collector

rules:
    - Tests\PHPStan\RateLimiter\RequestCastInRateLimiterRule
    - Tests\PHPStan\FormRequest\ValidatedKeyNotInRulesRule
