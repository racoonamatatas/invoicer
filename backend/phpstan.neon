includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - app/
        - tests/
    # Read the casts from the body of casts(): its `@return array<string, string>` docblock says nothing per key.
    parseModelCastsMethod: true
    excludePaths:
        # Arch tests are declarative chains on arch(), which reach expect() through Pest's __call, so PHPStan can't see
        # them. They hold no logic to type-check.
        - tests/Arch/

    ignoreErrors:
        # A Pest dataset reaches the test closure through ->with() at runtime, which PHPStan can't follow, and it
        # ignores a docblock on a closure passed as an argument. So a dataset's array parameter stays a plain `array`.
        -
            message: '#^Parameter .+ expects .+, array given\.$#'
            identifier: argument.type
            paths:
                - tests/Feature/Business/CreateBusinessTest.php
                - tests/Feature/Business/UpdateBusinessTest.php
                - tests/Feature/Client/CreateClientTest.php
                - tests/Feature/Invoices/CreateInvoiceTest.php
                - tests/Unit/Invoicing/InvoiceTotalsTest.php

services:
    -
        class: Tests\PHPStan\PestClosureThisExtension
        tags:
            - phpstan.functionParameterClosureThisExtension
