{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*", "src/**/*.vue"],
  "compilerOptions": {
    // Extra safety for array and object lookups, but may have false positives.
    "noUncheckedIndexedAccess": true,

    // The preset's list plus ES2023.Intl, which types `Intl.NumberFormat.format()`
    // taking a decimal string, so an amount is formatted without becoming a float.
    // Chrome 106, Firefox 116 and Safari 15.4 format the string exactly. Vite's
    // default build target still allows Firefox 114 and 115, which read it as
    // a float, so there an amount past about €10^13 can show the wrong cent.
    "lib": ["ES2022", "ES2023.Intl", "DOM", "DOM.Iterable"],

    // Path mapping for cleaner imports.
    "paths": {
      "@/*": ["./src/*"]
    },

    "types": ["vite/client"],

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
